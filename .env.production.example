# Production settings for the Corporate Helpdesk API.
# Copy to `.env` ON THE SERVER, fill in the real values there, and never commit the result.
# Check the outcome with:  php artisan helpdesk:preflight
# Every value below is a placeholder.

APP_NAME="Corporate Helpdesk"
APP_ENV=production
APP_DEBUG=false
# Generate once with `php artisan key:generate` and keep it (changing it invalidates encrypted data).
APP_KEY=
# Public URL of THIS API, https only.
APP_URL=https://api.helpdesk.example.org

# Public URL of the React app (no trailing slash). Used for CORS and for links in emails.
FRONTEND_URL=https://helpdesk.example.org
# Optional extra origins allowed by CORS, comma-separated.
# CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# A dedicated database account with rights on this schema only (not root).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=corporate_helpdesk
DB_USERNAME=helpdesk_app
DB_PASSWORD=

# ---- Mail (required: verification and password-reset emails depend on it) ----
# Test it with:  php artisan helpdesk:mail-test you@yourcompany.org
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
# "smtp" + port 587 = STARTTLS; use MAIL_SCHEME=smtps with port 465 for implicit TLS.
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@example.org
MAIL_FROM_NAME="${APP_NAME}"

# ---- Behind a reverse proxy / load balancer ----
# IPs or CIDR ranges of the proxies whose X-Forwarded-* headers may be believed, comma-separated.
# "*" trusts every caller and is only safe when the app is reachable solely through the proxy.
# Without this the per-IP rate limits (login, registration, password reset) see one shared address.
TRUSTED_PROXIES=
# Turn on once the site is HTTPS-only (browsers then refuse plain HTTP for a year).
HSTS_ENABLED=true

# ---- Sessions, cache, queue (the API itself uses Bearer tokens, not cookies) ----
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# Ticket notification emails go through the queue. This MUST stay "database" (or redis): "sync"
# would send them inside the web request. It also REQUIRES a running worker, or no ticket email is
# ever delivered: `php artisan queue:work --tries=3 --max-time=3600` under Supervisor (see docs/deployment.md).
QUEUE_CONNECTION=database
# Set to false to switch every ticket email off (account emails are unaffected).
TICKET_NOTIFICATIONS_ENABLED=true
FILESYSTEM_DISK=local

# ---- Auth and retention ----
AUTH_TOKEN_TTL=720
AUTH_REMEMBER_TOKEN_TTL=43200
SANCTUM_EXPIRATION=43200
LOGIN_ACTIVITY_RETENTION_DAYS=90

# Time zone whose calendar days Reports counts in (default UTC). Set it to your organisation's,
# e.g. Asia/Dhaka, so "today" and each day's totals match the working day.
REPORTS_TIMEZONE=UTC

# ---- Attachments (PHP's upload_max_filesize / post_max_size and the web server's body limit must be larger) ----
ATTACHMENT_MAX_SIZE_KB=5120
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_REQUEST_KB=15360
